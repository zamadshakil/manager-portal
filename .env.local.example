# AI Manager Portal — Local Environment Template
# Copy this to .env.local and fill in real values.
# .env.local is gitignored (.env*.local) — NEVER commit it.
#
# RAILWAY ARCHITECTURE:
#   Kong (public API gateway) -> Postgrest, GoTrue Auth, Realtime, Storage, Studio
#   Postgres (direct TCP proxy for external/local access)
#   Redis (Upstash — accessible from anywhere)
#   manager-portal (this Next.js app)

# ============================================================================
# SUPABASE — self-hosted on Railway, fronted by Kong
# URL:  Kong service -> Settings -> Networking -> public domain
# Keys: JWT tokens signed by GoTrue JWT_SECRET (NOT managed Supabase keys)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://kong-production-<your-id>.up.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://kong-production-<your-id>.up.railway.app
SUPABASE_JWT_SECRET=your-gotrue-jwt-secret

# ============================================================================
# POSTGRES — direct connection
# LOCAL: use the PUBLIC TCP proxy (Railway Dashboard -> Postgres -> Connect)
#   Format: postgresql://<user>:<pass>@<proxy-host>:<proxy-port>/postgres
# PRODUCTION (Railway internal): uses POSTGRES_PRIVATE_URL (auto-injected)
#
# Test from terminal:
#   psql "postgresql://<user>:<pass>@<proxy-host>:<port>/postgres"
# ============================================================================
DATABASE_URL=postgresql://supabase_admin:<password>@<proxy-host>:<port>/postgres
SUPABASE_DB_URL=postgresql://supabase_admin:<password>@<proxy-host>:<port>/postgres
POSTGRES_DATABASE=postgres
POSTGRES_USER=supabase_admin

# ============================================================================
# REDIS — Upstash (works from both Railway and local — no tunnel needed)
# Get connection string from https://console.upstash.com
# ============================================================================
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379
KV_URL=rediss://default:<token>@<host>.upstash.io:6379
KV_REST_API_URL=https://<host>.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
KV_REST_API_READ_ONLY_TOKEN=your_upstash_read_only_token

# ============================================================================
# AI / LLM
# OpenRouter: single gateway for chat + embeddings
# ============================================================================
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SMART_AI_MODEL=anthropic/claude-sonnet-4.6
EMBEDDING_MODEL=openai/text-embedding-3-small
JINA_API_KEY=jina_...

# ============================================================================
# CLOUDFLARE R2 — file storage
# ============================================================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ============================================================================
# VERCEL BLOB (legacy — some upload routes still use this)
# ============================================================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ============================================================================
# EMAIL — BREVO
# Get API key: https://app.brevo.com/settings/keys/api
# ============================================================================
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME=AI Manager Portal
COMPANY_ADDRESS=Johar Town, Lahore

# ============================================================================
# OPS DASHBOARD — /ops backup & restore console
# Completely independent of Supabase auth.
# Generate JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
OPS_USERNAME=ops_admin
OPS_PASSWORD=<strong-random-password>
OPS_JWT_SECRET=<32-char-random-hex>

# ============================================================================
# SECURITY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
CRON_SECRET=your-cron-secret-min-32-chars

# ============================================================================
# APPLICATION
# ============================================================================
# Production canonical URL (set this in Railway Variables, not here):
# NEXT_PUBLIC_SITE_URL=https://system.zamdevai.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Preview showcase guest access (optional; keep disabled in production)
# -----------------------------------------------------------------------------
# Guest credentials remain server-only. The login page only receives the
# SHOWCASE_GUEST_LOGIN_ENABLED boolean and posts the selected persona.
SHOWCASE_GUEST_LOGIN_ENABLED=false
SHOWCASE_GUEST_MANAGER_EMAIL=
SHOWCASE_GUEST_MANAGER_PASSWORD=
SHOWCASE_GUEST_MEMBER_EMAIL=
SHOWCASE_GUEST_MEMBER_PASSWORD=

# Required only while running `pnpm showcase:provision` against the intended
# preview database. Do not set this on the deployed app.
SHOWCASE_PROVISION_CONFIRM=

# Fresh showcase databases need both flags during their first boot. Strict
# mode prevents the app from serving against a partially migrated schema.
RUN_MIGRATIONS_ON_BOOT=false
MIGRATIONS_STRICT=false
NODE_ENV=development

# ============================================================================
# STARTUP MIGRATION RUNNER (instrumentation.ts)
# When true, the app applies any pending supabase/migrations/*.sql files to
# the DB on every cold start (tracked in public._app_migrations).
# Set to "true" in Railway Variables for the manager-portal service.
# Leave unset or "false" locally to avoid accidental dev-DB migrations.
# Requires SUPABASE_DB_URL (direct Postgres connection, not the Kong URL).
# ============================================================================
# RUN_MIGRATIONS_ON_BOOT=true
