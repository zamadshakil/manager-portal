# Hierarchia Manager Portal - Local Environment Template
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive credentials

# ============================================================================
# SUPABASE CONFIGURATION
# Get these from your Supabase project at https://supabase.com
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# UPSTASH REDIS CONFIGURATION
# Get these from your Upstash project at https://console.upstash.com
# Used for rate limiting, idempotency locks, and pipeline state across stages.
# ============================================================================
UPSTASH_REDIS_REST_URL=https://your-region-your-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-auth-token-here

# ============================================================================
# UPSTASH QSTASH (validation pipeline queue)
# Get these from https://console.upstash.com/qstash
# Used to break the AI pipeline into independently retried stages so the
# validation flow is not bound to a single function's wall-clock budget.
# Without these, the pipeline falls back to Next.js after() (single function,
# 60s ceiling) which is fine for local dev but unsafe for production.
# ============================================================================
QSTASH_TOKEN=your-qstash-publish-token
QSTASH_CURRENT_SIGNING_KEY=sig_xxx
QSTASH_NEXT_SIGNING_KEY=sig_yyy

# ============================================================================
# VERCEL BLOB STORAGE
# Get this from your Vercel project settings -> Storage -> Blob.
# Used for file uploads (submissions, materials).
# ============================================================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ============================================================================
# GOOGLE GEMINI (AI validation)
# Get an API key at https://aistudio.google.com/app/apikey
# The AI SDK provider (@ai-sdk/google) reads this env var automatically.
# ============================================================================
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Optional model overrides (defaults work for ~95% of teams).
# - VALIDATION + SUMMARY default to gemini-flash-lite-latest (cheap, fast).
# - VISION defaults to gemini-flash-latest (better at images / OCR).
# GEMINI_VALIDATION_MODEL=gemini-flash-lite-latest
# GEMINI_SUMMARY_MODEL=gemini-flash-lite-latest
# GEMINI_VISION_MODEL=gemini-flash-latest

# Optional pipeline tuning. Defaults are safe for production.
# LLM_CALL_TIMEOUT_MS=20000        # per-call hard timeout
# LLM_RULE_CONCURRENCY=8           # parallel rules per stage
# PIPELINE_BUDGET_MS=50000         # function-level abort budget

# ============================================================================
# APPLICATION URL (required in production for QStash callbacks)
# Set this to your production URL so QStash knows where to deliver stage
# messages. On Vercel preview deploys we fall back to VERCEL_URL.
# ============================================================================
APP_URL=https://your-domain.com

# ============================================================================
# SECURITY & AUTHENTICATION
# Generate a strong random string for CRON_SECRET. Used by /api/cron/* to
# verify Vercel Cron callers.
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
CRON_SECRET=your-cron-secret-here-min-32-chars

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development

# Optional: Set to "true" to enable verbose [v0] logging.
DEBUG=false
