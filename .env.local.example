# Hierarchia Manager Portal - Local Environment Template
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive credentials
#
# As of the Railway migration the *entire* backend (Supabase, MCP service,
# RAG service, Postgres + pgvector, Storage, Realtime) lives in a single
# Railway project. The portal itself runs as the `manager-portal` service
# in that same project. Values below are split by which Railway service
# owns them.

# ============================================================================
# SUPABASE (self-hosted on Railway, fronted by Kong)
#
# After migrating off the managed Supabase paid plan, the public URL is the
# Kong service's domain on Railway. The anon + service-role keys MUST be the
# new JWTs signed by the self-hosted GoTrue's `JWT_SECRET` — the keys from
# the managed project will not validate against the new GoTrue.
#
# Where to find these on Railway:
#   - URL  -> Kong service -> Settings -> Networking -> public domain
#   - Keys -> Supabase template variables (ANON_KEY, SERVICE_ROLE_KEY)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://kong-production-<your-id>.up.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# SMART AI — MCP service (Node.js, Railway service: mcp-service)
#
# Bearer-token auth. Token must match MCP_SERVICE_TOKEN on the mcp-service.
# Use Railway's private networking URL (`http://mcp-service.railway.internal:3030`)
# when calling from the portal to keep traffic on the project's private
# network. Use the public URL only for local dev.
# ============================================================================
MCP_SERVICE_URL=http://mcp-service.railway.internal:3030
MCP_SERVICE_TOKEN=replace-with-shared-secret-min-32-chars

# ============================================================================
# SMART AI — RAG service (FastAPI, Railway service: FastAPI-8UVj / rag-service)
#
# The portal only calls /v1/analytics directly; the rest goes via mcp-service.
# Use the private URL the same way as MCP_SERVICE_URL above.
# ============================================================================
RAG_SERVICE_URL=http://rag-service.railway.internal:8000
RAG_SERVICE_TOKEN=replace-with-shared-secret-min-32-chars

# Model used by the chat fallback path AND by the mcp-service.
# Defaults to openai/gpt-4o-mini if unset.
SMART_AI_MODEL=openai/gpt-4o-mini
SMART_AI_TOP_K=6

# LLM provider for Smart AI. Pick ONE:
#   1. OpenRouter (recommended — single key for chat + embeddings)
#   2. AI_GATEWAY_API_KEY (Vercel AI Gateway)
#   3. OPENAI_API_KEY  (direct OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# DIGITALOCEAN AI INFERENCE (legacy — used by validation pipeline)
# Get this from your DigitalOcean Control Panel -> API / AI Inference
# ============================================================================
DO_AI_API_KEY=your_digitalocean_ai_api_key_here
DO_AI_BASE_URL=https://inference.do-ai.run/v1
DO_VALIDATION_MODEL=deepseek-3.2
DO_SUMMARY_MODEL=deepseek-3.2
DO_VISION_MODEL=openai-gpt-4o-mini

# ============================================================================
# UPSTASH REDIS — caching, rate limiting, scheduled tasks
# ============================================================================
UPSTASH_REDIS_REST_URL=https://your-region-your-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-auth-token-here

# ============================================================================
# CLOUDFLARE R2 — file storage
#
# NOTE: the Railway Supabase stack also ships Supabase Storage + S3 + Imgproxy
# (see the deployment graph). We currently keep R2 as the canonical bucket;
# migrate to Supabase Storage if you want to consolidate to a single backend.
# ============================================================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ============================================================================
# GROQ — document parsing fallback
# ============================================================================
GROQ_API_KEY=gsk_xxx

# ============================================================================
# BACKGROUND JOBS
#
# The AI validation pipeline runs as a fire-and-forget async function inside
# the Railway Node process — no external orchestrator needed.
#
# Scheduled jobs (mark missed assignments, expire content) run via Railway
# cron hitting GET /api/cron/mark-missed with the CRON_SECRET below.
# ============================================================================

# ============================================================================
# SECURITY & AUTHENTICATION
# Generate a strong random string for CRON_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
CRON_SECRET=your-cron-secret-here-min-32-chars

# Public URL for the portal — used for OpenRouter analytics referer headers
# and any absolute URLs in transactional emails.
NEXT_PUBLIC_SITE_URL=https://manager-portal-production-<your-id>.up.railway.app

# ============================================================================
# BREVO EMAIL API
# Get this from https://app.brevo.com/settings/keys/api
# ============================================================================
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME="AI Manager Portal"

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development
DEBUG=false
