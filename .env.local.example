# Hierarchia Manager Portal - Local Environment Template
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive credentials
#
# The entire backend (Supabase, Postgres + pgvector, Storage, Realtime)
# lives in a single Railway project. The portal itself runs as the
# `manager-portal` service in that same project. Smart AI (chat, RAG,
# analytics) runs natively inside the Next.js app — no separate services.

# ============================================================================
# SUPABASE (self-hosted on Railway, fronted by Kong)
#
# After migrating off the managed Supabase paid plan, the public URL is the
# Kong service's domain on Railway. The anon + service-role keys MUST be the
# new JWTs signed by the self-hosted GoTrue's `JWT_SECRET` — the keys from
# the managed project will not validate against the new GoTrue.
#
# Where to find these on Railway:
#   - URL  -> Kong service -> Settings -> Networking -> public domain
#   - Keys -> Supabase template variables (ANON_KEY, SERVICE_ROLE_KEY)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://kong-production-<your-id>.up.railway.app
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# DIRECT POSTGRES CONNECTION (optional but recommended)
#
# Used by the RAG indexer (lib/smart-ai/pg-client.ts) to write directly to
# Postgres, bypassing PostgREST's column-level schema cache which has been
# unreliable on the self-hosted Supabase stack.
#
# Use the Postgres internal URL on Railway. Falls back to SUPABASE_DB_URL
# or DATABASE_URL if this is unset.
# ============================================================================
SUPABASE_DB_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/postgres

# ============================================================================
# SMART AI — LLM CONFIGURATION
#
# OpenRouter provides a single OpenAI-compatible gateway to dozens of models.
# The same key powers both the Smart AI chat and the validation pipeline.
# ============================================================================

# LLM provider for Smart AI chat + RAG embeddings
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used by the Smart AI chat. Defaults to openai/gpt-4o-mini if unset.
SMART_AI_MODEL=openai/gpt-4o-mini

# Optional: Direct OpenAI key for embeddings (faster, preferred over OpenRouter
# for text-embedding-3-small). Falls back to OpenRouter if unset.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# AI VALIDATION PIPELINE — MODEL OVERRIDES
#
# The validation pipeline uses OpenRouter with Gemini 2.0 Flash by default.
# These env vars let you swap models without redeploying. The DO_* prefix
# is a legacy naming convention that is still supported.
# ============================================================================
DO_VALIDATION_MODEL=google/gemini-2.0-flash-001
DO_SUMMARY_MODEL=google/gemini-2.0-flash-001
DO_VISION_MODEL=google/gemini-2.0-flash-001

# Legacy fallback: if OPENROUTER_API_KEY is unset, the pipeline checks
# DO_AI_API_KEY as a fallback provider key.
# DO_AI_API_KEY=your_api_key_here
# DO_AI_BASE_URL=https://inference.do-ai.run/v1

# ============================================================================
# REDIS (Railway-native) — rate limiting, idempotency locks, cron observability
#
# We use Railway's built-in Redis service. After provisioning the Redis plugin
# in your Railway project:
#   1. Open the `manager-portal` service -> Variables.
#   2. Click "Reference variable" and select Redis -> REDIS_URL.
#      Railway will inject the internal connection string automatically.
#
# For local dev you can either point to a local Docker Redis
# (`docker run -p 6379:6379 redis:7-alpine`) or leave REDIS_URL unset — the
# limiter will fail-OPEN locally and fail-CLOSED in production.
# ============================================================================
REDIS_URL=redis://default:<password>@<host>:6379

# ============================================================================
# CLOUDFLARE R2 — file storage
#
# NOTE: the Railway Supabase stack also ships Supabase Storage + S3 + Imgproxy
# (see the deployment graph). We currently keep R2 as the canonical bucket;
# migrate to Supabase Storage if you want to consolidate to a single backend.
# ============================================================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ============================================================================
# BACKGROUND JOBS
#
# The AI validation pipeline runs as a fire-and-forget async function inside
# the Railway Node process — no external orchestrator needed.
#
# Scheduled jobs (mark missed assignments, expire content) run via Railway
# cron hitting GET /api/cron/mark-missed with the CRON_SECRET below.
# ============================================================================

# ============================================================================
# SECURITY & AUTHENTICATION
# Generate a strong random string for CRON_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
CRON_SECRET=your-cron-secret-here-min-32-chars

# Public URL for the portal — used for OpenRouter analytics referer headers
# and any absolute URLs in transactional emails.
NEXT_PUBLIC_SITE_URL=https://manager-portal-production-<your-id>.up.railway.app

# ============================================================================
# BREVO EMAIL API
# Get this from https://app.brevo.com/settings/keys/api
# ============================================================================
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME="AI Manager Portal"

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development
DEBUG=false
