# Hierarchia Manager Portal - Local Environment Template
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive credentials

# ==============================================================================
# DIGITALOCEAN AI INFERENCE API
# Get this from your DigitalOcean Control Panel -> API / AI Inference
# ==============================================================================
DO_AI_API_KEY="your_digitalocean_ai_api_key_here"

# Standard DO AI Inference OpenAI-compatible endpoint
DO_AI_BASE_URL="https://inference.do-ai.run/v1"

# We use DeepSeek V3 (deepseek-3.2) by default for extremely high quality logic and formatting.
DO_VALIDATION_MODEL="deepseek-3.2"
DO_SUMMARY_MODEL="deepseek-3.2"
DO_VISION_MODEL="openai-gpt-4o-mini"

# ============================================================================
# SUPABASE CONFIGURATION
# Get these from your Supabase project at https://supabase.com
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# UPSTASH REDIS CONFIGURATION
# Get these from your Upstash project at https://upstash.com
# Used for caching, rate limiting, and scheduled tasks
# ============================================================================
UPSTASH_REDIS_REST_URL=https://your-region-your-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-auth-token-here

# ============================================================================
# VERCEL BLOB STORAGE
# Get these from your Vercel project settings
# Used for file uploads (documents, resumes, etc.)
# ============================================================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ============================================================================
# GROQ AI CONFIGURATION
# Get API key from https://console.groq.com
# Used for document parsing and AI features
# ============================================================================
GROQ_API_KEY=gsk_xxx

# ============================================================================
# SECURITY & AUTHENTICATION
# Generate a strong random string for CRON_SECRET
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================
CRON_SECRET=your-cron-secret-here-min-32-chars

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
NODE_ENV=development

# ============================================================================
# DEVELOPMENT ONLY
# Optional: Set to "true" to enable verbose logging
# ============================================================================
DEBUG=false
