# Load Test Dashboard — Environment Variables
# Copy this file to .env and fill in the values.
# These 2 values are already in your manager-portal/.env.local

# The target app URL (pre-filled to your production domain)
VITE_TARGET_URL=https://system.zamdevai.com

# Paste the value of NEXT_PUBLIC_SUPABASE_URL from manager-portal/.env.local
VITE_SUPABASE_URL=

# Paste the value of NEXT_PUBLIC_SUPABASE_ANON_KEY from manager-portal/.env.local
VITE_SUPABASE_ANON_KEY=
